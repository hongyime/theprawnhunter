REDIS_MEM_LIMIT=1280m
API_CPUS=2.00
API_MEM_LIMIT=2g
WORKER_CORE_CPUS=2.00
WORKER_CORE_MEM_LIMIT=2g
WORKER_SCANNERS_CPUS=2.00
WORKER_SCANNERS_MEM_LIMIT=2g
WORKER_SCRAPE_CPUS=2.00
WORKER_SCRAPE_MEM_LIMIT=2g
WORKER_VALIDATORS_CPUS=2.00
WORKER_VALIDATORS_MEM_LIMIT=2g
BOT_CPUS=0.50
BOT_MEM_LIMIT=512m
FRONTEND_CPUS=1.00
FRONTEND_MEM_LIMIT=1g

# Runtime concurrency used by docker-compose.prod.yml.
