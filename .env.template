# ============================================
# CORS Configuration
# ============================================
# Add extra origins allowed to call the API from browsers.
# Comma-separated list of full origins (scheme + host + port).
# The API always allows FRONTEND_URL and localhost variants.
# Use this to permit additional dev machines or staging frontends.
# Example: EXTRA_CORS_ORIGINS=http://192.168.1.50:3000,https://staging.example.com
# EXTRA_CORS_ORIGINS=

# ============================================
# Rescrape Backpressure
# ============================================
# Skip re-scrape if the scrape queue already has this many pending tasks.
# Prevents unbounded queue growth when session acquisition is slow / in FloodWait.
# Default: 2 x RESCRAPE_BATCH_SIZE (100 when BATCH_SIZE=50).
# Set lower (e.g. 20) on single-session setups to gate more aggressively.
RESCRAPE_BACKPRESSURE_THRESHOLD=100

# ============================================
# Broadcast Batch Size
# ============================================
# Messages fetched per broadcast_pending run.
# Default 200 (200 x 1.5s = 300s, fits inside 15-min claim window).
# Raise to 500 only if you have multiple bot tokens in the pool - a single
# bot sending 500 msgs/run will hit Telegram flood-wait regularly.
BROADCAST_BATCH_SIZE=200
BROADCAST_RETRY_MAX_DELAY_SECONDS=86400
BROADCAST_RETRY_JITTER_RATIO=0.20

