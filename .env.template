# unless you have copied the data into clean replacement volumes.
REDIS_VOLUME_NAME=telegramhunter_redis_data
SESSIONS_VOLUME_NAME=telegramhunter_sessions
IMPORTS_VOLUME_NAME=telegramhunter_imports
BEAT_SCHEDULE_VOLUME_NAME=telegramhunter_beat_schedule

# Resource limits. Increase only after observing sustained pressure.
