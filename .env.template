# ============================================
# Telegram Hunter - Docker Configuration
# ============================================

# General Configuration
ENV=development
DEBUG=False

# Redis (Docker internal network)
REDIS_URL=redis://redis:6379/0

# Encryption Key
# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-44-char-fernet-key-here
PSEUDONYMIZATION_KEY=                    # Stable HMAC key for pseudonymous user identifiers; do not rotate casually

# Optional: Protect monitor endpoints (/monitor/*) with this API key (sent as X-Monitor-Key)
MONITOR_API_KEY=

# ALERT_WEBHOOK_URL=                          # POST JSON alert here on credential_activated / honeypot_update (leave blank to disable)
# ALERT_WEBHOOK_SECRET=                       # Sent as X-Webhook-Secret header — optional auth for your receiver

# Extension (Chrome): Enter your Supabase URL and anon key directly in the extension popup.
# Credentials are stored in chrome.storage.sync — never committed to source control.
# Generate a strong random secret and set it in BOTH places:
#   1. Here (so you can copy it into the extension popup)
#   2. In Supabase SQL Editor: ALTER DATABASE postgres SET app.extension_write_secret = '<value>';
# Retrieve from Supabase anytime: SELECT current_setting('app.extension_write_secret');
EXTENSION_WRITE_SECRET=

# ============================================
# Supabase Database
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Postgres URL for schema management and read-only drift checks.
# Do not expose this to the frontend. Used by scripts/schema_drift_check.py.
# Example shape:
# postgresql://postgres.<project-ref>:<password>@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# GitHub Actions Secrets (for keepalive workflow to prevent auto-pause)
# Set these in GitHub Repository Settings -> Secrets and variables -> Actions:
# - NEXT_PUBLIC_SUPABASE_URL = your Supabase project URL (same as SUPABASE_URL)
# - NEXT_PUBLIC_SUPABASE_KEY = your Supabase anon key (same as SUPABASE_KEY)
# These keys allow GitHub Actions to ping the database every 3 days to prevent 7-day auto-pause.

# ============================================
# Telegram Configuration
# ============================================

# Your Monitoring Bot(s) (created via @BotFather)
# Supports multiple bots for rotation (comma-separated)
# When a bot is locked, it recommends another bot to the user
MONITOR_BOT_TOKEN=123456789:replace-token,987654321:replace-token
MONITOR_GROUP_ID=-1001234567890

# Optional: Bot IDs to keep in group (comma-separated)
WHITELISTED_BOT_IDS=

# Telegram API (from my.telegram.org)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your-api-hash

# Automatically close/lock monitor-group forum topics for credentials marked revoked.
# Close uses Telegram closeForumTopic; it does not delete topic history.
AUTO_CLOSE_REVOKED_TOPICS=True
REVOKED_TOPIC_CLOSE_INTERVAL_MINUTES=5
REVOKED_TOPIC_CLOSE_BATCH_SIZE=25
REVOKED_TOPIC_CLOSE_DELAY_SECONDS=0.5
REVOKED_TOPIC_CLOSE_TIMEOUT_SECONDS=10

# ============================================
# Honeypot Mode (Push Webhook Receiver)
# ============================================
# When enabled, the system takes over third-party webhooks on captured bots
# and re-registers them to point at YOUR public HTTPS endpoint.
# Telegram then PUSHes messages to you in real-time (no polling needed).
#
# Requirements:
#   - Public HTTPS endpoint (Cloudflare Tunnel recommended)
#   - HONEYPOT_MODE=True
#   - HONEYPOT_WEBHOOK_URL=https://your-public-domain/honeypot
#   - HONEYPOT_SECRET=<random 32+ char string>
#   - HONEYPOT_ALLOWLIST=AUTO (all bots) or comma-separated UUIDs
#
# Flow:
#   1. System scrapes captured bot token
#   2. Detects third-party webhook (C2 endpoint)
#   3. Deletes it via deleteWebhook
#   4. Calls setWebhook pointing to HONEYPOT_WEBHOOK_URL/receive/{credential_id}
#   5. Telegram pushes all future messages to your endpoint
#   6. API stores them in honeypot_updates table
#
HONEYPOT_MODE=False
HONEYPOT_WEBHOOK_URL=
HONEYPOT_SECRET=
HONEYPOT_ALLOWLIST=

# ============================================
# Honeypot Redirect (Migration Funnel)
# ============================================
# When honeypot captures a user's message, automatically reply FROM the
# captured bot directing them to your onboard bot.
#
# Example message sent:
#   "⚠️ This service has been migrated.
#    Your request could not be processed here.
#    To continue, use the updated channel:
#    👉 https://t.me/bryanseahbot?start=migrate
#    This is an automated notification."
#
# Per-user deduplication ensures each user only receives redirect once per bot.
#
# HONEYPOT_REDIRECT_MODE=True keeps the tasks/beat schedule wired up (infrastructure).
# HONEYPOT_REDIRECT_AUTHORIZED=false blocks all outbound outreach at runtime.
# BOTH must be true for redirects to actually leave the box. Default = OFF.
HONEYPOT_REDIRECT_MODE=True
HONEYPOT_REDIRECT_AUTHORIZED=false
HONEYPOT_REDIRECT_BOT=bryanseahbot
HONEYPOT_REDIRECT_DEEPLINK=migrate

# ============================================
# OSINT API Keys (Optional but recommended)
# ============================================

# GitHub Personal Access Token (single-token fallback for code search)
GITHUB_TOKEN=
# GitHub Personal Access Tokens (comma-separated pool; preferred when you have multiple PATs)
GITHUB_TOKENS=

# GitLab Personal Access Token
GITLAB_TOKEN=

# Bitbucket - API token auth (app passwords deprecated June 2026)
# BITBUCKET_USER = your Atlassian account EMAIL (not username, not token name)
# BITBUCKET_API_TOKEN = the token value from bitbucket.org/account/settings/api-tokens/
# Token needs "Repositories: Read" scope for code search
BITBUCKET_USER=
BITBUCKET_API_TOKEN=

# Serper.dev API Key (replacement for Google CSE)
SERPER_API_KEY=

# Shodan API Key
SHODAN_KEY=

# FOFA API (paid plan only). Leave blank if you only use the web / extension path.
FOFA_EMAIL=
FOFA_KEY=

# URLScan.io API Key
URLSCAN_KEY=

# Exa API keys. EXA_API_KEY_2/3 are optional rotation keys.
EXA_API_KEY=
EXA_API_KEY_2=
EXA_API_KEY_3=

# PublicWWW API Key
PUBLICWWW_KEY=

# Google Custom Search (for dorking)
GOOGLE_SEARCH_KEY=
GOOGLE_CSE_ID=

# ============================================
# Netlas - internet-wide host search (like Shodan but different index)
# Two accounts rotated automatically. Daily usage tracked in Redis.
# Account 1: 50 req/day, 2500 search coins
# Account 2: 100 req/day, 5000 search coins
# Scan runs once daily at 3am UTC - budget: ~135 queries/day total
# ============================================
NETLAS_API_KEY_1=
NETLAS_API_KEY_2=

# ==================================
# Scheduling & Frequencies
# ==================================
BROADCAST_INTERVAL_MINUTES=1
RESCRAPE_INTERVAL_HOURS=1
SCAN_INTERVAL_HOURS=4
AUDIT_INTERVAL_HOURS=2
COMPOSE_PROJECT_NAME=theprawnhunter

# ============================================
# Operational Alert Thresholds
# ============================================
# Queue alerting checks celery, scrape, scanners, and validation.
QUEUE_ALERT_LENGTH_THRESHOLD=100
QUEUE_ALERT_OLDEST_AGE_SECONDS=900
OPERATIONAL_REPORT_WINDOW_HOURS=24
BROADCAST_FAILURE_ALERT_THRESHOLD=5
SCRAPE_REASON_ALERT_THRESHOLD=10
CANARY_STALE_SECONDS=3600

# Telegram control-channel log throttling.
# Set TELEGRAM_LOG_MIN_INTERVAL_SECONDS=0 only during short manual debugging.
TELEGRAM_LOG_MIN_INTERVAL_SECONDS=2
TELEGRAM_LOG_FAILURE_WARN_INTERVAL_SECONDS=60

# Optional: comma-separated list of PREVIOUS Fernet keys, used only to
# decrypt ciphertext encrypted before the current ENCRYPTION_KEY was set.
# Rotation flow:
#   1. Generate new key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   2. Move current ENCRYPTION_KEY value here (comma-append if legacy already set)
#   3. Set ENCRYPTION_KEY to the new key
#   4. Restart workers
#   5. Run: docker exec theprawnhunter_worker-core python scripts/rotate_credentials.py
#   6. When re-encryption complete, remove the old key from this list
ENCRYPTION_KEY_LEGACY=

# Flower dashboard (Celery task monitor) — bound to 127.0.0.1 by default.
# Format: user:password. Use a strong password; the dashboard exposes
# task kwargs (bot_ids, credential_ids, but tokens are already redacted
# by AuditLogger). Access via `ssh -L 8555:localhost:8555` or bind at Docker
# level. Default 'admin:changeme' — CHANGE THIS BEFORE PRODUCTION.
FLOWER_BASIC_AUTH=admin:changeme

# ============================================
# Country Targeting (Optional)
# ============================================
# TARGET_COUNTRIES is a Python list of ISO-3166 country codes used for
# country-rotation scanning in Shodan, FOFA, and URLScan.
# Defaults to a built-in list of 50 high-Telegram-usage countries.
# Override by setting a JSON array: TARGET_COUNTRIES=["US","DE","RU"]
# Leave unset to use the default list.
# TARGET_COUNTRIES=

# ============================================
# Port Overrides (change if you have conflicts)
# ============================================
